{
  "name": "WT-3 Laravel (PHP 8.3)",
  "image": "mcr.microsoft.com/devcontainers/php:1-8.3",
  "workspaceFolder": "/workspaces/WT-3/laravel",
  "features": {
    "ghcr.io/devcontainers/features/composer:1": {},
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  "forwardPorts": [8000, 5173],
  "postCreateCommand": "php -v && composer -V && node -v && npm -v"
}